# Environment variable NAMES only. Never commit real values.
# Copy to .env and fill in locally.

# Google Cloud (Vertex AI generation, GCS artifacts, Cloud Run deploy)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=europe-west1

# Vertex model IDs — verify current IDs before use; override here, never in code
VERTEX_TEXT_MODEL=gemini-3.1-flash
VERTEX_REASONING_MODEL=gemini-3-pro
VERTEX_IMAGE_MODEL=imagen-4
VERTEX_VIDEO_MODEL=veo-3.1-fast
VERTEX_TTS_MODEL=chirp-3-hd
VERTEX_MUSIC_MODEL=lyria-2

# ClickHouse Cloud (write path via driver; read path via mcp-clickhouse server)
CLICKHOUSE_HOST=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=conform
CLICKHOUSE_MCP_URL=
CLICKHOUSE_MCP_AUTH_TOKEN=

# Artifact store
ARTIFACT_BUCKET=

# App
PORT=8080
WEB_ORIGIN=http://localhost:5173

# Spend cap: builds whose estimate exceeds this are blocked pending override
BUILD_BUDGET_USD=5.00

# Demo switches
FAULT_INJECTION=off
